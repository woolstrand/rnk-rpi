# Copy this file to .env and fill in your camera's real IP/credentials.
# .env is gitignored -- never commit real credentials.
#
# If CAMERA_IP is left unset, the camera API returns 503 (camera not
# configured) and the rest of the service (motor control) works normally.

CAMERA_IP=192.168.1.50
CAMERA_ONVIF_PORT=80
CAMERA_USERNAME=admin
CAMERA_PASSWORD=changeme

# Seconds to wait for an ONVIF SOAP call before giving up.
CAMERA_ONVIF_TIMEOUT_S=5

# RTSP stream location. Either set CAMERA_RTSP_URL directly (recommended if
# your camera's RTSP path/port doesn't match the defaults below), or leave
# it unset and let the app build one from CAMERA_IP plus the settings
# below and the credentials above.
# CAMERA_RTSP_URL=rtsp://admin:changeme@192.168.1.50:554/stream1
CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH=stream1
