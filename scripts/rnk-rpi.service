[Unit]
Description=rnk-rpi motorized platform controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __PROJECT_DIR__ and __USER__ are substituted by scripts/setup.sh
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/python main.py
Restart=always
RestartSec=3
User=__USER__
# The user must be in the "gpio" group (setup.sh adds them) to access /dev/gpiomem.
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
